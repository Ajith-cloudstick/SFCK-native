{
  "expo": {
    "name": "sfck",
    "slug": "sfck",
    "version": "1.0.0",
    "scheme": "sfck",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ajithcloudstick.sfck"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#EEF7F1",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "package": "com.ajithcloudstick.sfck"
    },
    "web": {
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF"
        }
      ],
      "expo-status-bar",
      "expo-sqlite",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Scan worker ID cards to mark attendance",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "f6ec9840-3920-4b96-b594-7e73fffb2c8a"
      }
    }
  }
}
